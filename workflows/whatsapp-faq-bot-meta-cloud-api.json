    },
    {
      "parameters": {
        "jsCode": "let raw = $input.item.json.content.find(i => i.type === 'text').text;\nraw = raw.trim().replace(/^```(json)?/i, '').replace(/```$/, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    reply: \"Sorry, I'm having a little trouble right now, someone from our team will get back to you shortly!\",\n    escalate: true,\n    reason: \"AI response failed to parse: \" + raw.substring(0, 200)\n  };\n}\n\nreturn { json: { ...$input.item.json, reply: parsed.reply, escalate: parsed.escalate, reason: parsed.reason, sender_number: $('Extract Message').item.json.sender_number, message_text: $('Extract Message').item.json.message_text } };"
      },
